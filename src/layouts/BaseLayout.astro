---
import '@fontsource-variable/jost';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/marcellus';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource/abril-fatface';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import BackBar from '../components/BackBar.astro';
import { getDefaultDescription, getSettings, url } from '../lib/content';

interface Props {
  /** Shown in the browser tab, before your name. Leave empty on the home page. */
  title?: string;
  /** One line for search engines and link previews. Defaults to the home page intro. */
  description?: string;
  /** Show the "Back" link at the top of the page. Every page has it except Home. */
  backLink?: boolean;
  /** Extra links next to "Back", such as "Back to work samples" on sample pages. */
  backLinks?: { label: string; href: string; icon?: import('../lib/icons').IconName }[];
  /** Leave out the history "Back" link and show only the extra links. */
  backLinksOnly?: boolean;
  /** On phones, pin the links under the top menu while scrolling. */
  stickyBackBar?: boolean;
}

const settings = await getSettings();
const {
  title,
  description = await getDefaultDescription(),
  backLink = true,
  backLinks,
  backLinksOnly = false,
  stickyBackBar = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${settings.name}` : `${settings.name} | ${settings.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The link preview image (1200 × 630) shown when a page is shared on LinkedIn, Slack, etc.
const previewImage = new URL(url('/og-image.jpg'), Astro.site);
const previewAlt = `${settings.name}, ${settings.role.toLowerCase()}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon: a "DP" monogram in Abril Fatface (files in public/). -->
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={url('/favicon-16x16.png')} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={url('/site.webmanifest')} />

    <!-- Link previews (Open Graph for LinkedIn, Slack, Facebook; Twitter card for X). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={previewAlt} />
    <meta name="theme-color" content="#ffffff" />

    {
      /* Private visitor analytics (GoatCounter: no cookies, no visible counter).
         Turned on by the goatcounter setting in content/settings.md. */
      settings.goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${settings.goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }

    <script is:inline>
      // Light mode is the default. Apply a saved dark-mode choice before the page draws.
      // Turn on the gentle scroll fade-in unless the visitor prefers reduced motion.
      (function () {
        const root = document.documentElement;
        try {
          if (localStorage.getItem('theme') === 'dark') root.dataset.theme = 'dark';
        } catch {}
        if (
          'IntersectionObserver' in window &&
          window.matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          root.classList.add('motion');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header name={settings.name} />
    <main id="main">
      {backLink && <BackBar links={backLinks} back={!backLinksOnly} sticky={stickyBackBar} />}
      <slot />
      <BackToTop />
    </main>
    <Footer settings={settings} />

    <script is:inline>
      // Scroll animations replay: an item animates each time it scrolls into view,
      // and resets once it has scrolled completely out of view.
      (function () {
        if (!document.documentElement.classList.contains('motion')) return;
        const show = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) entry.target.classList.add('is-visible');
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        const hide = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) entry.target.classList.remove('is-visible');
          }
        });
        // Groups that replay together (the home page hero) restart once they are
        // well back in view, and reset once they have left it completely.
        const replay = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) entry.target.classList.add('is-reset');
              else if (entry.intersectionRatio >= 0.35) entry.target.classList.remove('is-reset');
            }
          },
          { threshold: [0, 0.35] },
        );
        const watch = () => {
          document.querySelectorAll('[data-reveal]').forEach((el) => {
            show.observe(el);
            hide.observe(el);
          });
          document.querySelectorAll('[data-replay]').forEach((el) => replay.observe(el));
        };
        watch();

        // The browser's Back button can show a saved copy of the page with its
        // animations already finished. Reset everything so they play again.
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted) return;
          for (const observer of [show, hide, replay]) observer.disconnect();
          document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.remove('is-visible'));
          document.querySelectorAll('[data-replay]').forEach((el) => el.classList.add('is-reset'));
          requestAnimationFrame(() => requestAnimationFrame(watch));
        });
      })();
    </script>
  </body>
</html>
